{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "title": "Device status v1",
  "required": [
    "schemaVersion",
    "deviceId",
    "connectionId",
    "state",
    "reportedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "deviceId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "connectionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "online",
        "offline"
      ]
    },
    "reportedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "batteryPercent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "online"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "reportedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z$"
          }
        }
      }
    }
  ]
}
